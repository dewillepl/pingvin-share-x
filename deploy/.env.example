# Copy to .env (ignored by git) and adjust.

# Data directory (pingvin-share.db, uploads/, images/).
DATA_DIR=/srv/pingvin-share/data

# Owner of DATA_DIR: stat -c '%u %g' "$DATA_DIR"
PUID=1000
PGID=1000

# Docker network of your reverse proxy: docker network ls
PROXY_NETWORK=nginx-proxy_default

# Proxies in front of the backend: bundled Caddy + your reverse proxy = 2
TRUST_PROXY=2

# CA certificate for LDAPS with a private CA: put the PEM file into deploy/certs/
# (*.pem files are ignored by git). Leave empty if not needed.
NODE_EXTRA_CA_CERTS=
